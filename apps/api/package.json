{
  "name": "@slj/api",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "types": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply slj-local --local"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "@slj/contracts": "workspace:*",
    "@slj/domain": "workspace:*",
    "better-auth": "^1.7.23",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.18",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.2",
    "drizzle-kit": "^0.31.11",
    "vitest": "^4.1.12",
    "wrangler": "^4.162.0"
  }
}
